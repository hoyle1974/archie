#!/bin/sh
# Before every commit: refresh the graphify graph (gitignored) and check the OKF bundle.
set -e
cd "$(git rev-parse --show-toplevel)"

if command -v graphify >/dev/null 2>&1; then
  if [ -f graphify-out/graph.json ]; then
    graphify update . >/dev/null || { echo "pre-commit: graphify update failed" >&2; exit 1; }
  else
    echo "pre-commit: no graphify-out/graph.json yet; run /graphify . once in Claude Code" >&2
  fi
else
  echo "pre-commit: graphify not installed" >&2; exit 1
fi

python3 scripts/okf_check.py || { echo "pre-commit: OKF bundle is out of date (see above)" >&2; exit 1; }
